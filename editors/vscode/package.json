{
  "name": "tabnas-lsp-vscode",
  "displayName": "tabnas languages",
  "description": "Language support for tabnas grammars (generated by tabnas-lsp-gen)",
  "version": "0.1.0",
  "publisher": "REPLACE-WITH-YOUR-PUBLISHER",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:abnf",
    "onLanguage:bnf",
    "onLanguage:pgn",
    "onLanguage:csv",
    "onLanguage:ebnf",
    "onLanguage:feed",
    "onLanguage:gbnf",
    "onLanguage:json5",
    "onLanguage:jsonic",
    "onLanguage:jsonl",
    "onLanguage:zon"
  ],
  "contributes": {
    "languages": [
      {
        "id": "abnf",
        "extensions": [
          ".abnf"
        ],
        "aliases": [
          "abnf"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "bnf",
        "extensions": [
          ".bnf"
        ],
        "aliases": [
          "bnf"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "pgn",
        "extensions": [
          ".pgn"
        ],
        "aliases": [
          "pgn"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "csv",
        "extensions": [
          ".csv"
        ],
        "aliases": [
          "csv"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "ebnf",
        "extensions": [
          ".ebnf"
        ],
        "aliases": [
          "ebnf"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "feed",
        "extensions": [
          ".rss",
          ".atom"
        ],
        "aliases": [
          "feed"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "gbnf",
        "extensions": [
          ".gbnf"
        ],
        "aliases": [
          "gbnf"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "json5",
        "extensions": [
          ".json5"
        ],
        "aliases": [
          "json5"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "jsonic",
        "extensions": [
          ".jsonic"
        ],
        "aliases": [
          "jsonic"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "jsonl",
        "extensions": [
          ".jsonl"
        ],
        "aliases": [
          "jsonl"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "zon",
        "extensions": [
          ".zon"
        ],
        "aliases": [
          "zon"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "configuration": {
      "title": "tabnas",
      "properties": {
        "tabnas.serverPath": {
          "type": "string",
          "default": "tabnas-lsp",
          "description": "Command that starts the language server (--stdio is appended)."
        }
      }
    }
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.0"
  }
}
